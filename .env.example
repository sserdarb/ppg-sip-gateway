# Port the gateway listens on (Coolify proxy maps 443 → this)
PORT=8080

# Tescom PBX target
PBX_HOST=90.158.44.140
PBX_PORT=5060
PBX_TRANSPORT=udp

# Public-facing hostname (used in Via/Contact header rewrites)
GATEWAY_HOST=sip-gw.bluedreamsresort.com

# Set to 1 to log SIP message headers (verbose)
LOG_SIP=0

# ── PPG bridge ───────────────────────────────────────────────────────────────
PPG_API_URL=https://ppg.pmapartner.com
GATEWAY_SECRET=
# Hotel the bare AI extension (7000) represents when there is no DID/trunk
AI_DEFAULT_HOTEL=

# ── AI voice concierge ───────────────────────────────────────────────────────
AI_EXTENSION=7000
AI_RTP_PORT=5071
AI_HOTEL_NAME=

# Speech-to-text cascade. Providers self-skip without a key, so the order can
# list everything and you enable one by adding its key.
#   deepgram — Nova-2, best Turkish jargon handling (custom vocabulary)
#   groq     — whisper-large-v3-turbo, ~0.4s
#   whisper  — self-hosted faster-whisper, always-there fallback
AI_STT_ORDER=deepgram,groq,whisper
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_KEYWORD_BOOST=2
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
WHISPER_URL=http://ppg-whisper:9000
# adaptive (default) | pin | auto — see ai-agent.js. "adaptive" auto-detects the
# first turn then pins the language once it is stable (accuracy without losing
# the multilingual switch).
AI_STT_LANG_MODE=adaptive

# Text-to-speech cascade. ElevenLabs/Cartesia emit µ-law 8kHz natively (no
# resampling) and need a per-account voice id per voice profile; a profile with
# no id simply falls through to the next provider.
AI_TTS_ORDER=elevenlabs,cartesia,groq,google
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_VOICE_MAP={"female-tr":"<voiceId>","male-tr":"<voiceId>"}
ELEVENLABS_VOICE_MAP={}
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-2
CARTESIA_VOICE_MAP={}
GOOGLE_TTS_KEY=

# LLM. Alternatives worth A/B-ing for Turkish grammar + tool-call stability:
#   llama-3.3-70b-versatile (default), qwen-2.5-72b-instruct,
#   llama-3.1-70b-versatile, llama-3.1-8b-instant (cheap/fast)
AI_LLM_MODEL_GROQ=llama-3.3-70b-versatile
AI_LLM_MODEL_FALLBACK=llama-3.1-8b-instant
NVIDIA_API_KEY=
AI_LLM_MODEL=meta/llama-3.3-70b-instruct

# Intent router (layer 1). Runs before the main model on the first caller turn.
AI_ROUTER_ENABLED=1
AI_ROUTER_MODEL=llama-3.1-8b-instant
AI_ROUTER_TIMEOUT_MS=1200

# Turn-taking / VAD tuning
AI_SILENCE_MS=700
AI_MAX_UTTER_MS=10000
AI_VAD_RMS=500
AI_BARGE_RMS=1100
AI_BARGE_MS=320

# Live transfer. Per-department extensions; AI_TRANSFER_EXT is the fallback.
# AI_TRANSFER_EXT_MAP={"reception":"100","sales":"200","reservation":"300","manager":"400"}
AI_TRANSFER_EXT=
AI_TRANSFER_EXT_MAP={}
