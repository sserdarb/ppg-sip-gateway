# Port the gateway listens on (Coolify proxy maps 443 → this)
PORT=8080

# Tescom PBX target
PBX_HOST=90.158.44.140
PBX_PORT=5060
PBX_TRANSPORT=udp

# Public-facing hostname (used in Via/Contact header rewrites)
